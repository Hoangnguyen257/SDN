<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Update Order</title>
  <style>
    body { font-family: Arial, sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; background: #f0f4f8; margin: 0; }
    .card { background: white; padding: 30px; border-radius: 8px; width: 400px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    h1 { text-align: center; color: #1a73e8; margin-top: 0; }
    label { display: block; color: #1a73e8; margin-bottom: 4px; font-size: 14px; }
    input, select { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; margin-bottom: 16px; }
    .btn-submit { width: 100%; background: #1a73e8; color: white; padding: 12px; border: none; border-radius: 4px; font-size: 16px; cursor: pointer; }
    .btn-back { width: 100%; background: #f0a500; color: white; padding: 12px; border: none; border-radius: 4px; font-size: 16px; cursor: pointer; margin-top: 8px; }
    .error { color: red; margin-bottom: 12px; font-size: 14px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Update Order</h1>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form action="/orders/<%= order._id %>/update" method="POST">
      <label>Customer Name</label>
      <input type="text" name="customerName" value="<%= order.customerName %>" required />

      <label>Product Name</label>
      <select name="productName" required>
        <% products.forEach(p => { %>
          <option value="<%= p.productName %>" <%= order.productName === p.productName ? 'selected' : '' %>>
            <%= p.productName %>
          </option>
        <% }) %>
      </select>

      <label>Quantity</label>
      <input type="number" name="quantity" value="<%= order.quantity %>" min="1" required />

      <label>Order Date</label>
      <input type="date" name="orderDate" value="<%= new Date(order.orderDate).toISOString().split('T')[0] %>" required />

      <button type="submit" class="btn-submit">Update Order</button>
    </form>
    <a href="/orders"><button class="btn-back">Go Back</button></a>
  </div>
</body>
</html>
