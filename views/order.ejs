<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Product Orders</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; background: #f0f4f8; }
    h1 { text-align: center; color: #1a73e8; }
    table { width: 100%; border-collapse: collapse; background: white; }
    th { background: #1a73e8; color: white; padding: 10px; }
    td { padding: 10px; border-bottom: 1px solid #ddd; text-align: center; }
    .btn-update { background: #f0a500; color: white; border: none; padding: 6px 12px; cursor: pointer; border-radius: 4px; }
    .btn-delete { background: #e53935; color: white; border: none; padding: 6px 12px; cursor: pointer; border-radius: 4px; }
    .btn-create { display: block; margin: 20px auto; background: #1a73e8; color: white; border: none; padding: 10px 24px; font-size: 16px; cursor: pointer; border-radius: 4px; }
  </style>
</head>
<body>
  <h1>Product Orders</h1>
  <table>
    <thead>
      <tr>
        <th>Customer Name</th>
        <th>Product Name</th>
        <th>Quantity</th>
        <th>Order Date</th>
        <th>Total Price</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(order => { %>
      <tr>
        <td><%= order.customerName %></td>
        <td><%= order.productName %></td>
        <td><%= order.quantity %></td>
        <td><%= new Date(order.orderDate).toLocaleDateString('en-US') %></td>
        <td><%= order.totalPrice.toLocaleString() %> VND</td>
        <td>
          <a href="/orders/<%= order._id %>/update">
            <button class="btn-update">Update</button>
          </a>
          <form action="/orders/<%= order._id %>/delete" method="POST" style="display:inline">
            <button class="btn-delete" onclick="return confirm('Delete this order?')">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <a href="/orders/create"><button class="btn-create">Create New Order</button></a>
</body>
</html>
